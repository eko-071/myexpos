int main()
{
decl
    int temp, num, check;
enddecl
begin
    num=2;
    while (num <= 100) do
        check = 1;
        temp = 2;
        while (temp <= (num/2)) do
            if ((num % temp) == 0) then
                check = 0;
                break;
            endif;
            temp = temp + 1;
        endwhile;
        if (check == 1) then
            temp = exposcall( "Write" , -2, num );
        endif;
        num = num + 1;
    endwhile;
    return 0;
end
}